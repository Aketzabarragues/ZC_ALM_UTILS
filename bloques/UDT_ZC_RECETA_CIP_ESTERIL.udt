      TiempoEmpujeDestinoACIP : Int;   // ESTERILIZACIÓN. Tiempoi empuje desde equipo a CIP
      TiempoMaxEsterilizacion : Int;   // ESTERILIZACIÓN. Tiempo Maximo Enjuague
      TiempoEsterilizacionConConductividad : Int;   // ESTERILIZACIÓN. Tiempo enjuague con conductividad
      ReservaInt_1 : Int;   // ESTERILIZACIÓN. 
