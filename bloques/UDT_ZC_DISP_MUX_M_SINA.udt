TYPE "UDT_ZC_DISP_MUX_M_SINA"
VERSION : 0.1
   STRUCT
      Habilitar : Bool := FALSE;   // Habilitar gestion multiplexado
      ExisteCambio : Bool := FALSE;   // Existe algun cambio
