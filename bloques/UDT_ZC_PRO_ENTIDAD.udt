TYPE "UDT_ZC_PRO_ENTIDAD"
VERSION : 0.1
   STRUCT
      Habilitar : Bool;   // Habilitar unidad
      ID : Int;   // ID Unidad
      Asignacion : Int;   // Num Proceso que ha capturado la unidad
      Estado : Struct
         Disponible : Bool := false;   // Disponible (Gestion automatica
         Capturada : Bool := false;   // Capturada
         EnProduccion : Bool := false;   // En produccion
         EnCIP : Bool := false;   // En CIP
         EnSIP : Bool := false;   // En SIP
         EnStandby : Bool := false;   // En Standby
         Limpia : Bool := false;   // Limpia
         Sucia : Bool := false;   // Sucia
         Esterilizada : Bool;   // Esterilizada
         ConProducto : Bool := false;   // Con producto
         ConAgua : Bool := false;   // Con agua
         Vacia : Bool := false;   // Vacia
         Reserva_12 : Bool := false;
         Reserva_13 : Bool := false;
         Reserva_14 : Bool;
         Reserva_15 : Bool;
         Producto : Int;   // Tipo de producto
         CodEstado : Int;   // Codigo de estado
      END_STRUCT;
      Alarma : Struct
         Dispositivo : Bool;   // Algun dispositivo en ERROR
         Manual : Bool;   // Algun dispositivo en MANUAL
         Reserva_3 : Bool;
         Reserva_4 : Bool;
         Reserva_5 : Bool;
         Reserva_6 : Bool;
         Reserva_7 : Bool;
         Reserva_8 : Bool;
      END_STRUCT;
      Dispositivo : Array[1.."N_MAX_ENTIDAD_DISPOSITIVOS"] of Struct
         Ubicación : USInt;   // Posición del dispositivo
         Tipo : USInt;   // 0 = Sin declarar / 1 = Valvula / 2 = Reserva. / 3 = Motor / 4 =  / 5 = Sinamics / 6 = Motor VF
         Num : USInt;   // Posición dispositivo
      END_STRUCT;
   END_STRUCT;

END_TYPE

