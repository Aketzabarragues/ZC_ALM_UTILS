TYPE "UDT_ZC_DISP_TP"
VERSION : 0.1
   STRUCT
      PT : Int := 5;   // Duración del impulso
      ET : Int := 0;   // Valor actual de tiempo
      IN : Bool := FALSE;   // Activar temporizador
      Q : Bool := FALSE;   // Salida
      oldIN : Bool := FALSE;   // Estado anterior IN
   END_STRUCT;

END_TYPE

