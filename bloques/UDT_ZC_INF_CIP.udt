TYPE "UDT_ZC_INF_CIP"
VERSION : 0.1
   STRUCT
      CodigoReceta : Int;
      CodigoRegistro : Int;
      NombreReceta : String;
      NombreRegistro : String;
      LineaCIP : Int;
      TipoLimpieza : Struct
         Línea : Bool;   // Limpieza de línea
         Tanque : Bool;   // Limpieza de tanques
      END_STRUCT;
      TipoCIP : Struct
         Basico : Bool;   // Limpieza Basica seleccionada
         Acido : Bool;   // Limpieza Acida seleccionada
         SoloEnjuague : Bool;   // Solo enjuague seleccionado
         Paracetico : Bool;   // Limpieza Paracetica seleccionada
         Esterilización : Bool;   // Limpieza esterilización
         R_Bool_6 : Bool;
         R_Bool_7 : Bool;
      END_STRUCT;
      Opciones : Struct
         RecupAguaSosa : Bool;   // Recuperacion agua sosa seleccionada
         RecupAguaAcido : Bool;   // Recuperacion agua acido seleccionada
         RecupParacetico : Bool;   // Recuperacion agua paracético seleccionada
         EnjuagueCaliente : Bool;   // Enjuague caliente seleccionado
         CalentarAguaRecuperada : Bool;   // Calentar envío de agua recuperada
         RecuperarSandach : Bool;   // Recuperar en Tanque Sandach
         R_Bool_7 : Bool;
      END_STRUCT;
      FechaInicio { S7_SetPoint := 'False'} : "UDT_ZC_FECHA";
      FechaFin : "UDT_ZC_FECHA";
      TiempoLimpieza : "UDT_ZC_CONTADOR_TIEMPO";   // .
      Basico : Struct
         Limpieza : Struct
            Tiempo : UDInt;
            TemperaturaMedia : Real;
            ConductividadMedia : Real;
         END_STRUCT;
         Enjuague : Struct
            Tiempo : UDInt;
            TemperaturaMedia : Real;
            ConductividadMedia : Real;
         END_STRUCT;
      END_STRUCT;
      Acido : Struct
         Limpieza : Struct
            Tiempo : UDInt;
            TemperaturaMedia : Real;
            ConductividadMedia : Real;
         END_STRUCT;
         Enjuague : Struct
            Tiempo : UDInt;
            TemperaturaMedia : Real;
            ConductividadMedia : Real;
         END_STRUCT;
      END_STRUCT;
      Paracetico : Struct
         Limpieza : Struct
            Tiempo : UDInt;
            TemperaturaMedia : Real;
            ConductividadMedia : Real;
         END_STRUCT;
         Enjuague : Struct
            Tiempo : UDInt;
            TemperaturaMedia : Real;
            ConductividadMedia : Real;
         END_STRUCT;
      END_STRUCT;
      Esterilizacion : Struct
         Tiempo : UDInt;
         TemperaturaMedia { S7_SetPoint := 'True'} : Real;
      END_STRUCT;
      SoloEnjuague : Struct
         Tiempo : UDInt;
      END_STRUCT;
      FinalizadoManual : Bool;
      ValidacionParametros : Bool;
      ReservaBool_3 : Bool;
      ReservaBool_4 : Bool := false;
      ReservaBool_5 : Bool := false;
      ReservaBool_6 : Bool := false;
      ReservaBool_7 : Bool := false;
      InformeFinalizado : Bool := false;
      ReservaInt_1 : Int;
      ReservaInt_2 : Int;
      ReservaInt_3 : Int;
      ReservaInt_4 : Int;
      TotalizadorAgua : Real;
      ReservaReal_1 : Real;
      ReservaReal_2 : Real := 0.0;
      ReservaReal_3 : Real := 0.0;
      ReservaReal_4 : Real := 0.0;
   END_STRUCT;

END_TYPE

