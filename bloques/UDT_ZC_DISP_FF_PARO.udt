TYPE "UDT_ZC_DISP_FF_PARO"
VERSION : 0.1
   STRUCT
      Estado_Flip : Bool;   // Salida FLIP
      Estado_Flop : Bool;   // Salida FLOP
      Estado_Paro : Bool;   // Salida paro antes y despues de FLIP
      Orden_Activar : Bool;   // Orden Marcha
      Aux_FlipActivo : Bool;   // Auxiliar flip activo
      Aux_FlopActivo : Bool;   // Auxiliar flop activo
      Aux_Paro1Activo : Bool;   // Auxiliar paro 1 activo (antes de flip)
      Aux_Paro2Activo : Bool;   // Auxiliar paro 2 activo (despues de flip)
      Aux_Flanco : Bool;   // Aux flanco inicio
      Config_SetPointTiempoFlip : Int;   // Set point tiempo Flip
      Config_SetPointTiempoFlop : Int;   // Set point tiempo Flop
      Config_SetPointTiempoParo : Int;   // Set point tiempo Paro
      Aux_TiempoFlip : Int;   // Tiempo actual Flip
      Aux_TiempoFlop : Int;   // Tiempo actual Flop
      Aux_TiempoParo : Int;   // Tiempo actual Paro
   END_STRUCT;

END_TYPE

