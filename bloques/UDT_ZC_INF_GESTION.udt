TYPE "UDT_ZC_INF_GESTION"
VERSION : 0.1
   STRUCT
      HabilitacionGeneral : Bool := TRUE;   // Habilitacion de la traza
      EstadoConexion : Bool := TRUE;   // Estado de la conexion con el HMI
      OrdenIniciar : Bool := FALSE;   // Orden inicial
      Etapa : Int := 0;   // Etapa actual
      SP_Tiempo : Int := 0;   // SP Tiempo retardo
      TiempoActual : Int := 3;   // Tiempo retardo actual
      NumeroMaxIntentos : Int := 3;
      Aviso : Struct   // Aviso para HMI
         Registrar : Bool := FALSE;   // Orden
         Estado : Int := 0;
         NumeroIntentosActual : Int;
      END_STRUCT;
      Datos { S7_SetPoint := 'False'} : "UDT_ZC_INF_DATOS";   // Registro actual que se va a guardar en el Scada/Hmi
   END_STRUCT;

END_TYPE

