TYPE "UDT_ZC_PRO_TIEMPO_ETAPA"
VERSION : 0.1
   STRUCT
      Activar : Bool;   // Activar tiempo de etapa
      Cumplido : Bool;   // Tiempo etapa cumplido
      Reset : Bool;   // Reset tiempo de etapa
      Actual : Int;   // Tiempo de etapa actual
      SP : Int := 5;   // SP tiempo de etapa
      Restante : Int;   // Tiempo de etapa restante
   END_STRUCT;

END_TYPE

