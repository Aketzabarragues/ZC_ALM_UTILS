TYPE "UDT_ZC_TRAZA_GESTION"
VERSION : 0.1
   STRUCT
      HabilitacionGeneral : Bool := TRUE;   // Habilitacion de la traza
      EstadoConexion : Bool := TRUE;   // Estado de la conexion con el HMI
      OrdenIniciar : Bool := FALSE;   // Orden inicial
      HabilitarCategoria : Array[1..32] of Bool := [15(FALSE)];
      Etapa : Int := 0;   // Etapa actual
      SP_Tiempo : Int := 1;   // SP Tiempo retardo
      SP_TiempoTexto : Int := 2;   // SP Tiempo retardo para generar texto en Scada
      TiempoActual : Int := 3;   // Tiempo retardo actual
      Aviso : Struct
         AvisoWord : Array[0..1] of Word;
         Aviso : Array[0..32] of Bool;
         GenerarTexto : Array[0..32] of Bool;
         BorrarTexto : Bool;
         Datos : "UDT_ZC_TRAZA_DATOS";
      END_STRUCT;
   END_STRUCT;

END_TYPE

