TYPE "UDT_ZC_DISP_M"
VERSION : 0.1
   STRUCT
      Hmi_Index : Int;   // Index para listas HMI
      Hmi_Estado : Int;   // Visualizacion dispositivoHMI
      Estado_AutoMan : Bool := FALSE;   // 0= Automatico / 1= Manual
      Estado_Activado : Bool := FALSE;   // Estado motor activado
      Estado_Enclavado : Bool := FALSE;   // Enclavamiento del dispositivo
      Estado_EntradaTermico : Bool := FALSE;   // Entrada magnetotérmico
      Estado_EntradaConfMarcha : Bool := FALSE;   // Entrada confirmación marcha
      Alarmas_Termico : Bool := FALSE;   // Error chequeo magnetotérmico
      Alarmas_ConfirmacionMarcha : Bool := FALSE;   // Error chequeo confirmación marcha
      Alarmas_Mantenimiento : Bool := FALSE;   // Horas para mantenimiento alcanzados
      Alarmas_General : Bool := FALSE;   // Motor en error
      Orden_ActivarManual : Bool := FALSE;   // Orden activar manual
      Orden_ActivarAuto : Bool := FALSE;   // Orden activar automático
      Orden_ResetHoras : Bool := FALSE;   // Reset contador de horas de activación
      Config_Habilitar : Bool := FALSE;   // Activar tratamiento de dispositivo
      Config_HabilitarRetornoTermico : Bool := TRUE;   // Activar chequeo magnetotérmico
      Config_HabilitarInvertirTermico : Bool := FALSE;   // Invertir señal magnetotérmico
      Config_HabilitarRetornoConfMarcha : Bool := TRUE;   // Activar chequeo confirmación marcha
      Config_HabilitarInvertirConfMarcha : Bool := FALSE;   // Invertir señal confirmación marcha
      Config_HabilitarMantenimiento : Bool := FALSE;   // Habilitar alarma horas mantenimiento
      Aux_oldActivado : Bool;   // Estado anterior activado
      Aux_oldAlarma : Bool;   // Estado anterior Alarma
      Aux_oldAutoMan : Bool := false;   // Estado anterior Auto / Manual
      Estado_SeguridadOk : Bool := TRUE;   // Estado seguridad OK
      Config_GrupoAlarma : Int := 0;   // Grupo de alarma
      Config_DireccionSalidaByte : Int := 0;   // Dirección salida digital Byte
      Config_DireccionSalidaBit : Int := 0;   // Dirección salida digital Bit
      Config_DireccionRetTermicoByte : Int := 0;   // Dirección magnetotérmico Byte
      Config_DireccionRetTermicoBit : Int := 0;   // Dirección magnetotérmico Bit
      Config_DireccionRetConfMarchaByte : Int := 0;   // Dirección confirmación marcha Byte
      Config_DireccionRetConfMarchaBit : Int := 0;   // Dirección confirmación marcha Bit
      Tiempos_SetPointTiempoAlarma : UInt := 10;   // Consigna activación alarmas
      Tiempos_Alarma : UInt := 0;   // Tiempo activación alarmas
      Tiempos_SetPointMantenimiento : Real := 2000.0;   // Consigna alarma tiempo mantenimiento
      Tiempos_Mantenimiento : Real;   // Contador tiempo de funcionamiento
   END_STRUCT;

END_TYPE

