TYPE "UDT_ZC_PRO_PROCESO"
VERSION : 0.1
   STRUCT
      ID : Int := 100;   // Identificador Proceso
      EtapaActual : Int;   // Etapa Actual
      EtapaSiguiente : Int;   // Etapa Siguiente
      TipoProceso : Int := 1;   // 0=DESHABILITADO / 1= PRODUCCION / 2 = CIP / 3= SIP / 4= STANDBY
      Estado : Struct   // Estado Proceso
         Arrancando : Bool;   // Arrancando
         EnMarcha : Bool;   // EnMarcha
         MarchaPausa : Bool;   // En Marcha o Pausa
         Pausando : Bool;   // Pausando
         Pausado : Bool;   // Pausado
         Reanudando : Bool;   // Reanudando
         Finalizando : Bool;   // Finalizando
         Finalizado : Bool;   // Finalizado
         EnError : Bool;   // EnError
         Enclavado : Bool;   // Enclavado
         AlgunError : Bool;   // AlgunError
         AlgunAviso : Bool;   // AlgunAviso
         EntidadesCapturadas : Bool;   // Entidades capturadas (libre programacion)
         Reserva_2 : Bool;   // Reserva_2
         Reserva_3 : Bool;   // Reserva_3
         Reserva_4 : Bool;   // Reserva_4
         Reserva_5 : Bool;   // Reserva_5
         CodEstado : UInt;   // Estado del proceso
      END_STRUCT;
      BitMarcha { S7_SetPoint := 'False'} : "UDT_ZC_MARCHA_PARO_SEC";   // Bit de marcha retardados
      Entidad : Array[1.."N_MAX_ENTIDAD_PROCESO"] of Struct   // Entidades del proceso
         ID : Int;   // Numero de entidad
         Producto : Int;   // Codigo de producto
         Tipo : Bool;   // 0= Captura desde arranque / 1= Captura Usuario
         EstadoDisponible : Bool;   // Entidad disponible
         EstadoCapturada : Bool;   // Entidad capturada por proceso
         OrdenLiberar : Bool;   // Liberar entidad
         OrdenCapturar : Bool;   // Capturar entidad
         OrdenConProducto : Bool;   // Entidad con producto
         OrdenConAgua : Bool;   // Entidad con agua
         OrdenVacia : Bool;   // Entidad vacia
         R_Bool_9 : Bool;
         R_Bool_10 : Bool;
         R_Bool_11 : Bool;
         R_Bool_12 : Bool;
         R_Bool_13 : Bool;
         R_Bool_14 : Bool;
         R_Bool_15 : Bool;
         R_Bool_16 : Bool;
      END_STRUCT;
      Ordenes : Struct   // Ordenes desde PLC
         Marcha : Bool;   // Orden de Marcha
         Paro : Bool;   // Orden de Paro
         Pausa : Bool;   // Orden de Pausa
         Reanudar : Bool;   // Orden  Reanudar
         ResetErrores : Bool;   // Orden Reset Errores
         Reserva_1 : Bool;
         Reserva_2 : Bool;
         Reserva_3 : Bool;
         Reserva_4 : Bool;
         Reserva_5 : Bool;
         SaltarEtapa : Bool;   // OrdenSaltarEtapa
         Reserva_7 : Bool;
         Reserva_8 : Bool;
         Reserva_9 : Bool;
         Reserva_10 : Bool;
         Reserva_11 : Bool;
      END_STRUCT;
      Pulsadores : Struct
         Marcha { S7_SetPoint := 'False'} : "UDT_ZC_PULSADOR";   // Pulsador Marcha
         Paro { S7_SetPoint := 'False'} : "UDT_ZC_PULSADOR";   // Pulsador Paro
         Pausa { S7_SetPoint := 'False'} : "UDT_ZC_PULSADOR";   // Pulsador Pausa
         Reanudar { S7_SetPoint := 'False'} : "UDT_ZC_PULSADOR";   // Pulsador Reanudar
         ResetErrores { S7_SetPoint := 'False'} : "UDT_ZC_PULSADOR";   // Pulsador Reset Errores
         SaltoEtapa { S7_SetPoint := 'False'} : "UDT_ZC_PULSADOR";   // Pulsador Salto Etapa
      END_STRUCT;
      SaltoEtapa : Struct
         NuevaEtapa : Int;   // Nueva etapa introducida desde HMI
         CambioPosible : Bool;   // 1= es posible realizar el cambio
      END_STRUCT;
      Enclavamiento : Array[1..15] of Bool;
      Aviso : Struct
         Codigo : Int;
         Texto : String[25];
         Sistema : Array[1..8] of Bool;   // AVISOS SISTEMA
         Usuario : Array[1..8] of Bool;   // AVISOS USUARIO
      END_STRUCT;
      Error : Struct
         Codigo : Int;
         Texto : String[25];
         Sistema : Array[1..8] of Bool;   // ERROR SISTEMA
         Usuario : Array[1..8] of Bool;   // ERROR USUARIO
      END_STRUCT;
      VentanaAviso : Struct
         Mostrar : Bool;   // Mostrar emergente
         Aceptar { S7_SetPoint := 'False'} : "UDT_ZC_PULSADOR";
         Cancelar { S7_SetPoint := 'False'} : "UDT_ZC_PULSADOR";
         Tipo : Int;   // 0= Aceptar-Cancelar // 1= Solo Aceptar // 2=Solo Cancelar
         CodigoTexto1 : Int;   // Texto Ventana
         CodigoTexto2 : Int;   // Texto Ventana
         CodigoTextoAceptar : Int;   // Texto aceptar
         CodigoTextoCancelar : Int;   // Texto cancelar
      END_STRUCT;
      TiempoEtapa { S7_SetPoint := 'False'} : "UDT_ZC_PRO_TIEMPO_ETAPA";
      LitrosEtapa { S7_SetPoint := 'False'} : "UDT_ZC_PRO_LITROS_ETAPA";
      TON { S7_SetPoint := 'False'} : Array[1..2] of "UDT_ZC_DISP_TON";
      TONR { S7_SetPoint := 'False'} : "UDT_ZC_DISP_TONR";   // TONR Interno
      Informe : Struct
         OrdenIncio { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Orden de guardar hora de fin
         OrdenFin { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Orden de guardar hora de inicio
         OrdenMarcha { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Orden de activar temporizador
         ResetMarcha { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Orden de resetear el tiempo en marcha
         ResetTotal : Bool;   // Orden de resetear el tiempo total
         HoraInicio { S7_SetPoint := 'False'} : "UDT_ZC_FECHA";   // Hora de inicio de marcha
         HoraFin { S7_SetPoint := 'False'} : "UDT_ZC_FECHA";   // Hora de fin de marcha
         TiempoMarcha { S7_SetPoint := 'False'} : "UDT_ZC_CONTADOR_TIEMPO";   // Tiempo de marcha
         TiempoTotal : "UDT_ZC_CONTADOR_TIEMPO";   // Tiempo total de proceso no finalizado
      END_STRUCT;
      Aux : Struct
         oldPrimerArranque : Bool;
         oldInformeInicio : Bool;
         oldInformeFin : Bool;
         ParoOperador : Bool;
         ErroresComprobados : Bool;
         EntidadesDisponibles : Bool;   // UnidadesDisponibles
         EntidadesCargadas : Bool;   // UnidadesCargadas
         ProArrancadoOK : Bool;
         ProParadoOK : Bool;
         ProFinalizadoOK : Bool;
         oldEtapa : Int;
         TiempoResetParoOp : USInt;
         oldCodigoEstado : UInt;
         SecuenciaArranque : UInt;
      END_STRUCT;
      Flanco : Struct
         F_Arrancando : Bool;   // Flanco Arrancando
         F_EnMarcha : Bool;   // Flanco En Marcha
         F_Pausando : Bool;   // Flanco Pausando
         F_Pausado : Bool;   // Flanco Pausado
         F_Reanudando : Bool;   // Flanco Reanudando
         F_Finalizando : Bool;   // Flanco Finalizando
         F_Finalizado : Bool;   // Flanco Finalizado
         F_EnError : Bool;   // Flanco En Error
         F_InformeInicio : Bool;   // Flanco Inicio Informe
         F_InformeFin : Bool;   // Flanco Informe Fin
         F_CambioEtapa : Bool;   // Flanco cambio de etapa
         Reserva_12 : Bool;
         Reserva_13 : Bool;
         Reserva_14 : Bool;
         Reserva_15 : Bool;
         Reserva_16 : Bool;
      END_STRUCT;
   END_STRUCT;

END_TYPE

