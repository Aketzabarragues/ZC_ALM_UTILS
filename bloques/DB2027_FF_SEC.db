DATA_BLOCK "DB2027_FF_SEC"
TITLE = DB2027_FF_SEC
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : ABH
FAMILY : ZeusControl
VERSION : 1.0
NON_RETAIN
//Bloque de datos de Flip Flop secuencial.
   VAR RETAIN
      Mux { S7_SetPoint := 'False'} : "UDT_ZC_MUX";
      FF_SEC : Array[1.."N_MAX_DISP_FF_SEC"] of "UDT_ZC_DISP_FF_SEC";
   END_VAR


BEGIN
   Mux.Index := 1;
   Mux.MaxVisible := FALSE;
   FF_SEC[1].Estado_SalidaFlip1 := FALSE;
   FF_SEC[1].Estado_SalidaFlip2 := FALSE;
   FF_SEC[1].Estado_SalidaFlip3 := FALSE;
   FF_SEC[1].Estado_SalidaFlip4 := FALSE;
   FF_SEC[1].Estado_SalidaFlip5 := FALSE;
   FF_SEC[1].Estado_SalidaFlip6 := FALSE;
   FF_SEC[1].Estado_SalidaFlip7 := FALSE;
   FF_SEC[1].Estado_SalidaFlip8 := FALSE;
   FF_SEC[1].Estado_SalidaFlip9 := FALSE;
   FF_SEC[1].Estado_SalidaFlip10 := FALSE;
   FF_SEC[1].Estado_SalidaFlop := FALSE;
   FF_SEC[1].Orden_Reset := FALSE;
   FF_SEC[1].Orden_Activar := FALSE;
   FF_SEC[1].Aux_FlipActivo := FALSE;
   FF_SEC[1].Aux_FlopActivo := TRUE;
   FF_SEC[1].Aux_Flanco := FALSE;
   FF_SEC[1].Config_SetPointTiempoFlip1 := 1;
   FF_SEC[1].Config_SetPointTiempoFlip2 := 1;
   FF_SEC[1].Config_SetPointTiempoFlip3 := 0;
   FF_SEC[1].Config_SetPointTiempoFlip4 := 0;
   FF_SEC[1].Config_SetPointTiempoFlip5 := 0;
   FF_SEC[1].Config_SetPointTiempoFlip6 := 0;
   FF_SEC[1].Config_SetPointTiempoFlip7 := 0;
   FF_SEC[1].Config_SetPointTiempoFlip8 := 0;
   FF_SEC[1].Config_SetPointTiempoFlip9 := 0;
   FF_SEC[1].Config_SetPointTiempoFlip10 := 0;
   FF_SEC[1].Config_SetPointTiempoFlop := 70;
   FF_SEC[1].Aux_TiempoFlip := 0;
   FF_SEC[1].Aux_TiempoFlop := 0;
   FF_SEC[1].Aux_TiempoFlipTotal := 2;

END_DATA_BLOCK

