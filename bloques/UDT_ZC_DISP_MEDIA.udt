TYPE "UDT_ZC_DISP_MEDIA"
VERSION : 0.0
   STRUCT
      IniciarMedia : Bool;   // Iniciar media
      Inicializar : Bool;   // Reinicializar Media
      auxInicializar : Bool;   // P_TRIG Reinicializar Media
      auxTiempo : Int;   // Indice Tiempo para generar pulso
      auxIndice : DInt;   // Contador de sucesos
      auxAcumulado : LReal;   // Valor acumulado
      Media : LReal;   // Media Actual
      ValorMinimo : Real;   // Valor minimo ui
      ValorMaximo : Real;   // Valor maximo ui
   END_STRUCT;

END_TYPE

