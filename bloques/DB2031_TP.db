DATA_BLOCK "DB2031_TP"
TITLE = DB2031_TP
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : HCR
FAMILY : ZeusControl
VERSION : 1.0
//Dispositivo temporizador TP.
   VAR RETAIN
      TP : Array[0.."N_MAX_TP"] of "UDT_ZC_DISP_TP";
   END_VAR


BEGIN
   TP[0].PT := 5;
   TP[0].ET := 0;
   TP[0].IN := FALSE;
   TP[0].Q := FALSE;
   TP[0].oldIN := FALSE;
   TP[1].PT := 2;
   TP[1].ET := 0;
   TP[1].IN := FALSE;
   TP[1].Q := FALSE;
   TP[1].oldIN := FALSE;

END_DATA_BLOCK

