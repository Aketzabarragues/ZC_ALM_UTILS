TYPE "UDT_ZC_TRAZA_DATOS"
VERSION : 0.1
   STRUCT
      Registrar : USInt;   // Estado de la orden de grabar la traza
      TimeStamp : String[25];   // Fecha y Hora
      Categoria : Int;   // Categoria de traza
      User : String[25];   // Usuario
      Codigo1 : Int;   // Texto traza
      Codigo2 : Int;
      Codigo3 : Int;
      Texto : String[30];
   END_STRUCT;

END_TYPE

