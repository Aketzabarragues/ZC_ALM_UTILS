TYPE "UDT_ZC_DISP_SA"
VERSION : 0.1
   STRUCT
      Hmi_Index : Int;   // Index para listas HMI
      Hmi_Estado : Int;   // Visualizacion dispositivoHMI
      Estado_ValorIngenieria : Real := 0.0;   // Valor de salida analogica en unidades de ingenieria
      Estado_AutoMan : Bool := FALSE;   // 0= Automatico / 1= Manual
      Estado_Enclavado : Bool := FALSE;   // Enclavamiento del dispositivo
      Alarmas_Min : Bool := FALSE;   // Alarma por nivel minimo activa
      Alarmas_Max : Bool := FALSE;   // Alarma por nivel maximo activa
      Alarmas_Escritura : Bool := FALSE;   // Error de escritura
      Alarmas_Parametros : Bool := FALSE;   // Alarma de configuración
      Alarmas_General : Bool := FALSE;   // Salida analogica en error
      Config_Habilitar : Bool := FALSE;   // Activacion de la gestion de la entrada analogica
      Config_HabilitarAlarmaMin : Bool := FALSE;   // Habilitar comprobacion de alarma minnimo
      Config_HabilitarAlarmaMax : Bool := FALSE;   // Habilitar comprobacion de alarma maximo
      Aux_oldAlarma : Bool := false;   // Estado anterior Alarma
      Aux_oldAutoMan : Bool := false;   // Estado anterior Auto / Manual
      Estado_SeguridadOk : Bool := TRUE;   // Estado seguridad OK
      Config_GrupoAlarma : Int := 0;   // Grupo de alarma
      Aux_Estado : Int;
      Estado_ValorTarjeta : Int := 0;   // Valor en unidades de tarjeta
      Estado_Escritura : Word;   // Estado de escritura
      Orden_ConsignaManual : Real := 0.0;   // Valor de consigna en Manual
      Orden_ConsignaAuto : Real := 0.0;   // Valor de consigna en Auto
      Orden_ConsignaEnclavado : Real := 0.0;   // Valor de consigna enclavado
      Config_DireccionSalidaByte : Int := 0;   // Dirección de salida AW
      Config_EscaladoMinTarjeta : Int := 0;   // Valor minimo de tarjeta
      Config_EscaladoMaxTarjeta : Int := 27648;   // Valor maximo de tarjeta
      Config_EscaladoMinIngenieria : Real := 0.0;   // Valor minimo en unidades de ingenieria
      Config_EscaladoMaxIngenieria : Real := 0.0;   // Valor maximo en unidades de ingenieria
      Config_EscaladoOffset : Real := 0.0;   // Valor de offset en unidades de ingenieria (suma)
      Config_ErrorMinIngenieria : Real := 0.0;   // Valor de alarma minimo
      Config_ErrorMaxIngenieria : Real := 0.0;   // Valor de alarma maxima
   END_STRUCT;

END_TYPE

