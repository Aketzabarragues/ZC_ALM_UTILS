TYPE "UDT_ZC_INF_DOSIFICACION"
VERSION : 0.1
   STRUCT
      TimeStamp : String[25];   // Fecha y hora dosificacion
      Componente : String[20];   // Nombre componente
      NumeroReceta : Int;   // Numero de receta
      CiclosSP : Int;   // Nº de ciclos preseleccionados
      CicloActual : Int;   // Nº de ciclo en curso al finalizar la dosificacion
      Estado : Int;   // 1= OK / 2= Error Tol. Pos. / 3= Error Tol. Neg.
      R_Int_5 : Int;
      Pedido : Real;   // Cantidad pedido
      Servido : Real;   // Cantidad servida
      R_Real_3 : Real;
      R_Real_4 : Real;
      R_Real_5 : Real;
   END_STRUCT;

END_TYPE

