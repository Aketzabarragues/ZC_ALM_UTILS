TYPE "UDT_ZC_TIEMPO_CICLO"
VERSION : 0.1
   STRUCT
      Actual : Real := 0.0;   // Tiempo ciclo Actual ms
      Min : Real := 150.0;   // Tiempo ciclo Minimo ms
      Max : Real := 0.0;   // Tiempo ciclo Maximo ms
      auxMem : LReal := 0.0;
      Reset : Bool := FALSE;   // Reset tiempo de ciclo
   END_STRUCT;

END_TYPE

