      Estado_SalidaFlip9 : Bool;   // Salida Flip 9
      Estado_SalidaFlip10 : Bool;   // Salida Flip 10
      Estado_SalidaFlop : Bool;   // Salida Flop
      Orden_Reset : Bool;   // Resetear estado de acumuladores
      Orden_Activar : Bool;   // Orden Activacion
      Orden_Pausa : Bool;   // Orden pausa
      Aux_FlipActivo : Bool;   // Secuencia ON activada
      Aux_FlopActivo : Bool;   // Secuencia OFF activada
