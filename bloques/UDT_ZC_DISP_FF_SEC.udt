TYPE "UDT_ZC_DISP_FF_SEC"
VERSION : 0.1
   STRUCT
      Estado_SalidaFlip1 : Bool;   // Salida Flip 1
      Estado_SalidaFlip2 : Bool;   // Salida Flip 2
      Estado_SalidaFlip3 : Bool;   // Salida Flip 3
      Estado_SalidaFlip4 : Bool;   // Salida Flip 4
      Estado_SalidaFlip5 : Bool;   // Salida Flip 5
