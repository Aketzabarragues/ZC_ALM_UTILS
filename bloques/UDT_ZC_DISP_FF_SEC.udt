      Config_SetPointTiempoFlip9 : Int := 2;   // Set Point Tiempo Flip 9
      Config_SetPointTiempoFlip10 : Int := 2;   // Set Point Tiempo Flip 10
      Config_SetPointTiempoFlop : Int := 20;   // Set Point Tiempo Flop
      Aux_TiempoFlip : Int;   // Tiempo acumulador ON
      Aux_TiempoFlop : Int;   // Tiempo acumulador OFF
