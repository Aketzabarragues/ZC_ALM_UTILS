TYPE "UDT_ZC_INF_PROD_MEM"
VERSION : 0.1
   STRUCT
      FechaInicio { S7_SetPoint := 'False'} : "UDT_ZC_FECHA";   // Fecha de inicio
      FechaFin { S7_SetPoint := 'False'} : "UDT_ZC_FECHA";   // Fecha de fin
      Producto : Int;   // Tipo de producto
      DestinoConcentrado : Int;   // Destino concentrado
      DestinoPermeado : Int;   // Destino permeado
      LitrosEntrada : Real;   // Litros de entrada
      LitrosConcentrado : Real;   // Litros de concentrado
      LitrosPermeado : Real;   // Litros de permeado
      Brix : Real;   // Media de BRIX
      FCV : Real;   // Factor de concentracion
      TempEntrada : Real;   // Media temperatura entrada
      TempConcentrado : Real;   // Media temperatura concentrado
      TempPermeado : Real;   // Media temperatura permeado
      TiempoProduccion { S7_SetPoint := 'False'} : "UDT_ZC_CONTADOR_TIEMPO";   // Tiempo en produccion
   END_STRUCT;

END_TYPE

