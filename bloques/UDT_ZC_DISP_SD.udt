TYPE "UDT_ZC_DISP_SD"
VERSION : 0.1
   STRUCT
      Hmi_Index : Int;   // Index para listas HMI
      Hmi_Estado : Int;   // Visualizacion dispositivoHMI
      Estado_AutoMan : Bool := FALSE;   // 0= Automatico / 1= Manual
      Estado_Activado : Bool := FALSE;   // Estado de la salida
      Estado_Enclavado : Bool := FALSE;   // Enclavamiento del dispositivo
      Orden_ActivarManual : Bool := FALSE;   // Orden activar manual
      Orden_ActivarAuto : Bool := FALSE;   // Orden activar automático
      Config_Habilitar : Bool := FALSE;   // Activar tratamiento de dispositivo
      Config_HabilitarRetardoAct : Bool := FALSE;   // Activar retardo activación
      Config_HabilitarRetardoDes : Bool := FALSE;   // Activar retardo desactivación
      Config_HabilitarInvertir : Bool := FALSE;   // Invertir señal de salida
      Aux_oldActivado : Bool;   // Estado anterior activado
      Aux_oldAutoMan : Bool := false;   // Estado anterior Auto / Manual
      Estado_SeguridadOk : Bool := TRUE;   // Estado seguridad OK
      Config_GrupoAlarma : Int := 0;   // Grupo de alarma
      Config_DireccionSalidaByte : Int := 0;   // Dirección salida Byte
      Config_DireccionSalidaBit : Int := 0;   // Dirección salida Bit
      Tiempos_SetPointTiempoAct : UInt := 3;   // Consigna retardo de activación
      Tiempos_SetPointTiempoDes : UInt := 3;   // Consigna retardo de desactivación
      Tiempos_TiempoAct : UInt := 0;   // Tiempo activación actual
      Tiempos_TiempoDes : UInt := 0;   // Tiempo desactivación actual
   END_STRUCT;

END_TYPE

