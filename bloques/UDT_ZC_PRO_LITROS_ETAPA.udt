TYPE "UDT_ZC_PRO_LITROS_ETAPA"
VERSION : 0.1
   STRUCT
      Activar : Bool;   // Activar contaje de litros
      Cumplido : Bool;   // Litros etapa cumplido
      Reset : Bool;   // Reset Litros de etapa
      Visibilidad : Bool;   // Visibilidad de litros etapa
      Actual : Real := 0.0;   // Litros de etapa actual
      SP : Real := 1.0;   // SP Litros de etapa
      Restante : Real := 0.0;   // Litros de etapa restante
   END_STRUCT;

END_TYPE

