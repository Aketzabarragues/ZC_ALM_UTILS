TYPE "UDT_ZC_RECETA_CIP"
VERSION : 0.1
   STRUCT
      RutaID : Int;
      RutaNombre : String[100];
      RecetaID : String[80];
      RecetaNumero : Int;
      RecetaNombre : String[100];
      TipoLimpieza : Struct
         Linea : Bool;   // Limpieza de línea
         Tanque : Bool;   // Limpieza de tanques
         R_Bool_3 : Bool;
         R_Bool_4 : Bool;
         R_Bool_5 : Bool;
         R_Bool_6 : Bool;
         R_Bool_7 : Bool;
      END_STRUCT;
      TipoCIP : Struct
         Basico : Bool;   // Limpieza Basica seleccionada
         Acido : Bool;   // Limpieza Acida seleccionada
         SoloEnjuague : Bool;   // Solo enjuague seleccionado
         Paracetico : Bool;   // Limpieza Paracetica seleccionada
         Esterilizacion : Bool;   // Limpieza esterilización
         R_Bool_6 : Bool;
         R_Bool_7 : Bool;
         hmi : Word;
      END_STRUCT;
      Opciones : Struct
         RecupAguaSosa : Bool;   // Recuperacion agua sosa seleccionada
         RecupAguaAcido : Bool;   // Recuperacion agua acido seleccionada
         RecupParacetico : Bool;   // Recuperacion agua paracético seleccionada
         EnjuagueCaliente : Bool;   // Enjuague caliente seleccionado
         CalentarAguaRecuperada : Bool;   // Calentar envío de agua recuperada
         RecuperarRechazos : Bool;   // Recuperar en Tanque Rechazos
         R_Bool_7 : Bool;
         hmi : Word;
      END_STRUCT;
      Parametros : Struct
         Comunes { S7_SetPoint := 'False'} : "UDT_ZC_RECETA_CIP_COMUNES";
         Sosa : Struct
            Limpieza { S7_SetPoint := 'False'} : "UDT_ZC_RECETA_CIP_SOSA_LIMP";
            Enjuague { S7_SetPoint := 'False'} : "UDT_ZC_RECETA_CIP_SOSA_ENJ";
         END_STRUCT;
         Acido : Struct
            Limpieza { S7_SetPoint := 'False'} : "UDT_ZC_RECETA_CIP_ACIDO_LIMP";
            Enjuague { S7_SetPoint := 'False'} : "UDT_ZC_RECETA_CIP_ACIDO_ENJ";
         END_STRUCT;
         Peracetico : Struct
            Limpieza { S7_SetPoint := 'False'} : "UDT_ZC_RECETA_CIP_DESINF_LIMP";
            Enjuague { S7_SetPoint := 'False'} : "UDT_ZC_RECETA_CIP_DESINF_ENJ";
         END_STRUCT;
         SoloEnjuague : "UDT_ZC_RECETA_CIP_SOLO_ENJ";
         Esterilizacion : "UDT_ZC_RECETA_CIP_ESTERIL";
         Rechazos : "UDT_ZC_RECETA_CIP_RECHAZOS";
      END_STRUCT;
      ReservaInt_1 : Int;
      ReservaInt_2 : Int;
      ReservaReal_1 : Real;
      ReservaReal_2 : Real;
   END_STRUCT;

END_TYPE

