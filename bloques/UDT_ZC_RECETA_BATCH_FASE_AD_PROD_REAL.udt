TYPE "UDT_ZC_RECETA_BATCH_FASE_AD_PROD_REAL"
VERSION : 0.1
   STRUCT
      Permiso : Array[0..9] of Bool;   // Permiso para introducir el valor de kilos introducido
      Confirmado : Array[0..9] of Bool;   // Valor confirmado por usuario
      Calculado : Array[0..9] of Real;   // Valor calculado en base a referencia 1000Kg
      Valor : Array[0..9] of Real;   // Valor introducido por usuario
      Visibilidad : Bool;   // Visibilidad en SCADA
   END_STRUCT;

END_TYPE

