TYPE "UDT_ZC_INF_CHEQUEO"
VERSION : 0.1
   STRUCT
      PorcentajeBomba : Real;
      Temperatura : Real;
      Caudal : Real;
      CaudalPermeado : Real;
      Conductividad : Real;
      Presion : Real;
      ResultadoChequeo : Real;
      Fecha { S7_SetPoint := 'False'} : "UDT_ZC_FECHA";
      ResultadoAnimacion { S7_SetPoint := 'True'} : Bool;
   END_STRUCT;

END_TYPE

