TYPE "UDT_ZC_DISP_EA"
VERSION : 0.1
   STRUCT
      Hmi_Index : Int;   // Index para listas HMI
      Hmi_Estado : Int;   // Visualizacion dispositivoHMI
      Estado_ValorIngenieria : Real := 0.0;   // Valor de entrada analogica en unidades de ingenieria
      Estado_AutoMan : Bool := FALSE;   // 0= Automatico / 1= Manual
      Alarmas_Min : Bool := FALSE;   // Alarma por nivel minimo activa
      Alarmas_Max : Bool := FALSE;   // Alarma por nivel maximo activa
      Alarmas_HiloRoto : Bool := FALSE;   // Canal de entrada en fallo, hilo roto
      Alarmas_Lectura : Bool := FALSE;   // Error lectura
      Alarmas_Parametros : Bool;   // Alarma de configuración
      Alarmas_General : Bool := FALSE;   // Entrada analógica en error
      Config_Habilitar : Bool := FALSE;   // Activacion de la gestion de la entrada analogica
      Config_HabilitarAlarmaMin : Bool := FALSE;   // Habilitar comprobacion de alarma minnimo
      Config_HabilitarAlarmaMax : Bool := FALSE;   // Habilitar comprobacion de alarma maximo
      Config_HisteresisTipo : Bool := FALSE;   // Histeresis en unidades de ingenieria (0); Histeresis en porcentaje (1)
      Config_HabilitarEscalado : Bool := TRUE;   // 0= Valor directo / 1= Valor escalado
      Aux_oldAlarma : Bool := false;   // Estado anterior Alarma
      Aux_oldAutoMan : Bool := false;   // Estado anterior Auto / Manual
      Config_GrupoAlarma : Int := 0;   // Grupo de alarma
      Estado_ValorTarjeta : DInt := 0;   // Valor en unidades de tarjeta
      Estado_Lectura : Word;   // Estado de lectura
      Orden_ConsignaManual : Real := 0.0;   // Valor de la EA en uds. ingenieria si esta en manual
      Config_DireccionEntradaByte : Int := 0;   // Dirección de entrada EW
      Config_EscaladoMinTarjeta : Int := 0;   // Valor mínimo de tarjeta
      Config_EscaladoMaxTarjeta : Int := 27648;   // Valor máximo de tarjeta
      Config_EscaladoMinIngenieria : Real := 0.0;   // Valor mínimo en unidades de ingeniería
      Config_EscaladoMaxIngenieria : Real := 100.0;   // Valor máximo en unidades de ingeniería
      Config_EscaladoOffset : Real := 0.0;   // Valor de offset en unidades de ingeniería (suma)
      Config_ErrorMinIngenieria : Real := 0.0;   // Valor de alarma mínimo
      Config_ErrorMaxIngenieria : Real := 100.0;   // Valor de alarma máxima
      Config_ErrorMinHisteresis : Real := 0.0;   // Histéresis valor mínimo
      Config_ErrorMaxHisteresis : Real := 0.0;   // Histéresis valor máximo
      Aux_Estado : Int;
   END_STRUCT;

END_TYPE

