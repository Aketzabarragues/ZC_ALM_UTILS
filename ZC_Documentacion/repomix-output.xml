<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ayuda - Zeus Control ALM</title>
    <link rel="stylesheet" href="css/custom.css">
</head>
<body class="layout-shell">
    
    <header class="top-header">
        <div class="header-left">
            <img src="img/logo.png" alt="Zeus Control" onerror="this.style.display='none'">
        </div>
        <div class="header-center">
            Documentación de Ingeniería
        </div>
        <div class="header-right">
            ZEUS CONTROL
        </div>
    </header>

    <div class="main-container">
        
        <div class="sidebar">
            <div class="search-box"><input type="text" id="buscador" placeholder="🔍 Buscar por nombre..." onkeyup="filtrarMenu()"></div>
            
            <ul class="nav-list" id="listaBloques">
                
                <li>
                    <div class="titulo-seccion-menu" onclick="toggleMenu(this.querySelector('.toggle-btn'))">
                        <span class="toggle-btn"></span> 📚 MANUAL DE PROGRAMACIÓN
                    </div>
                    <ul class="nested" style="display: none;">
                        {{ manual_html | safe }}
                    </ul>
                </li>
                
                <li>
                    <div class="titulo-seccion-menu" onclick="toggleMenu(this.querySelector('.toggle-btn'))">
                        <span class="toggle-btn"></span> ⚙️ FUNCIONES (FC Y FB)
                    </div>
                    <ul class="nested" style="display: none;">
                        {{ funciones_html | safe }}
                    </ul>
                </li>

                <li>
                    <div class="titulo-seccion-menu" onclick="toggleMenu(this.querySelector('.toggle-btn'))">
                        <span class="toggle-btn"></span> 💾 DATOS (DB Y UDT)
                    </div>
                    <ul class="nested" style="display: none;">
                        {{ datos_html | safe }}
                    </ul>
                </li>
                
            </ul>

        </div>

        <div class="content-area">
            <iframe name="visor" src="{{ pagina_inicio }}"></iframe>
        </div>
    </div>

    <script>
        
        // === INTELIGENCIA DEL MENÚ: Escucha al iframe ===
        function marcarMenuDesdeIframe(urlIframe) {
            let links = document.querySelectorAll('.menu-link');
            let encontrado = false;
            let urlNormalizada = urlIframe.replace(/\\/g, '/');

            links.forEach(link => {
                let hrefLink = link.getAttribute('href');
                if (urlNormalizada.endsWith(hrefLink) || link.href === urlIframe) {
                    activarEstiloLink(link);
                    encontrado = true;
                }
            });
            
            if (!encontrado) {
                let urlSinHash = urlNormalizada.split('#')[0];
                links.forEach(link => {
                    let hrefSinHash = link.getAttribute('href').split('#')[0];
                    if (urlSinHash.endsWith(hrefSinHash) || link.href.split('#')[0] === urlSinHash) {
                        if (!encontrado) {
                            activarEstiloLink(link);
                            encontrado = true;
                        }
                    }
                });
            }
        }

        // === ACTIVA VISUALMENTE EL ITEM ===
        function activarEstiloLink(linkElement) {
            document.querySelectorAll('.menu-item').forEach(item => item.classList.remove('activo-menu'));
            let menuItem = linkElement.closest('.menu-item');
            
            if (menuItem) {
                menuItem.classList.add('activo-menu');
                
                // Desplegamos todos los padres
                let parentUl = menuItem.closest('ul.nested');
                while(parentUl) {
                    parentUl.style.display = 'block';
                    let parentLi = parentUl.closest('li');
                    if(parentLi) {
                        let btn = parentLi.querySelector('.toggle-btn');
                        if(btn) btn.classList.add('open'); // <-- Añadimos la clase en lugar de texto
                        parentUl = parentLi.closest('ul.nested');
                    } else break;
                }
                
                menuItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        document.querySelectorAll('.menu-link').forEach(link => {
            link.addEventListener('click', function(e) {
                activarEstiloLink(this);
            });
        });

        // Desplegar/plegar carpetas con colapso recursivo
        function toggleMenu(btn) {
            var li = btn.closest('li');
            var nestedUl = Array.from(li.children).find(c => c.classList.contains('nested'));
            
            if (nestedUl) {
                // Si está cerrado (o sin estilo definido aún), lo abrimos
                if (nestedUl.style.display === 'none' || nestedUl.style.display === '') { 
                    nestedUl.style.display = 'block'; 
                    btn.classList.add('open'); // Flecha hacia abajo
                } 
                // Si está abierto, lo cerramos y colapsamos TODO su contenido
                else { 
                    nestedUl.style.display = 'none'; 
                    btn.classList.remove('open'); // Flecha a la derecha
                    
                    // --- NUEVO: Magia recursiva para cerrar todo lo que hay debajo ---
                    
                    // 1. Ocultar todas las sub-listas (ul.nested) hijas
                    let subUls = nestedUl.querySelectorAll('.nested');
                    subUls.forEach(sub => sub.style.display = 'none');
                    
                    // 2. Quitar el estado 'open' a todos los sub-botones de flecha
                    let subBtns = nestedUl.querySelectorAll('.toggle-btn');
                    subBtns.forEach(subBtn => subBtn.classList.remove('open'));
                }
            }
        }

        // Buscador
        function filtrarMenu() {
            var input = document.getElementById('buscador').value.toUpperCase();
            var menuItems = document.querySelectorAll('.menu-link');
            menuItems.forEach(function(a) {
                var text = a.innerHTML.toUpperCase();
                var li = a.closest('li');
                if (text.indexOf(input) > -1) {
                    li.style.display = "";
                    if (input !== "") {
                        var parentUl = li.closest('ul.nested');
                        while(parentUl) {
                            parentUl.style.display = 'block';
                            var parentLi = parentUl.closest('li');
                            if(parentLi) {
                                parentLi.style.display = "";
                                var btn = parentLi.querySelector('.toggle-btn');
                                if(btn) btn.classList.add('open'); // <-- Asegura que se abra
                                parentUl = parentLi.closest('ul.nested');
                            } else break;
                        }
                    }
                } else {
                    if (input !== "") li.style.display = "none";
                    else li.style.display = "";
                }
            });
        }

        // Inicializar el estado de las flechas al cargar la página
        document.querySelectorAll('ul.nested').forEach(function(ul) {
            var btn = ul.closest('li').querySelector('.toggle-btn');
            if(btn) {
                if (ul.style.display === 'none') {
                    btn.classList.remove('open');
                } else {
                    btn.classList.add('open');
                }
            }
        });
    </script>
</body>
</html>
</file>

<file path="ui/templates/layout_page.html">
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{ titulo_pagina }}</title>
    <link rel="stylesheet" href="../css/custom.css">
</head>
<body>
    <div class="page-wrapper">
        <div class="page-content manual-content">
            {{ contenido | safe }}
            <div style="height: 500px;"></div>
        </div>
    </div>

    <script>
        // Avisar al index cuando la página carga por primera vez
        document.addEventListener("DOMContentLoaded", function() {
            if(window.parent && typeof window.parent.marcarMenuDesdeIframe === "function") {
                window.parent.marcarMenuDesdeIframe(window.location.href);
            }
        });

        // Avisar al index cuando navegamos a un enlace interno en la misma página (#)
        window.addEventListener("hashchange", function() {
            if(window.parent && typeof window.parent.marcarMenuDesdeIframe === "function") {
                window.parent.marcarMenuDesdeIframe(window.location.href);
            }
        });
    </script>
</body>
</html>
</file>

<file path="ui/templates/template_data.html">
<div class="doc-section">
    <h1>
        <span style="display: inline-block; padding: 4px 10px; background: #e8f4f8; color: #3498db; border-radius: 4px; font-weight: bold; font-size: 16px; margin-right: 10px; vertical-align: bottom;">
            {{ bloque.tipo }}
        </span>
        {{ bloque.nombre_bloque }}
    </h1>

    {% if bloque.descripcion %}
        <h3>Descripción General</h3>
        <p style="white-space: pre-wrap;">{{ bloque.descripcion }}</p>
    {% endif %}
</div>

{% if bloque.variables %}
<div class="doc-section" id="estructura_datos">
    <h3>Estructura de Datos</h3>
    <table>
        <tr>
            <th>Nombre</th>
            <th>Tipo de Dato</th>
            <th>Valor Inicial</th>
            <th>Comentario</th>
        </tr>
        {% for var in bloque.variables %}
        <tr>
            <td><strong>{{ var.nombre }}</strong></td>
            <td>{{ var.tipo }}</td>
            <td>
                {% if var.valor != "-" %}
                    <span style="color: #7f8c8d; font-family: monospace;">{{ var.valor }}</span>
                {% else %}
                    {{ var.valor }}
                {% endif %}
            </td>
            <td>{{ var.comentario }}</td>
        </tr>
        {% endfor %}
    </table>
</div>
{% endif %}

{% if contenido_original %}
<div class="doc-section" id="codigo_fuente" style="margin-top: 40px; border-top: 4px solid #3498db;">
    <h3>Código Fuente Completo</h3>
    <pre class="scl-code" style="max-height: 600px; overflow-y: auto;">{{ contenido_original | e }}</pre>
</div>
{% endif %}
</file>

<file path="ui/templates/template_scl.html">
<div class="doc-section">
    <h1>
        {% set tipo_badge = "SCL" %}
        {% if nombre_bloque.startswith('FB') %}{% set tipo_badge = "FB" %}
        {% elif nombre_bloque.startswith('FC') %}{% set tipo_badge = "FC" %}
        {% elif nombre_bloque.startswith('DB') %}{% set tipo_badge = "DB" %}
        {% elif nombre_bloque.startswith('OB') %}{% set tipo_badge = "OB" %}
        {% endif %}
        
        <span class="scl-badge">{{ tipo_badge }}</span>{{ nombre_bloque }}
    </h1>

    <div style="display: flex; flex-wrap: wrap; gap: 20px; color: #475569; font-size: 0.95em; margin-top: 25px; background: #f1f5f9; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
        
        {% if etiquetas.Version_Bloque %}
            <span><strong>Versión:</strong> {{ etiquetas.Version_Bloque }}</span>
        {% elif changelog and changelog.filas %}
            <span><strong>Versión:</strong> {{ changelog.filas[-1][0] }}</span>
        {% endif %}
        
        {% if changelog and changelog.filas %}
            <span><strong>Fecha:</strong> {{ changelog.filas[-1][1] }}</span>
        {% endif %}
        
        {% if etiquetas.Author_Bloque %}<span><strong>Autor:</strong> {{ etiquetas.Author_Bloque }}</span>
        {% elif etiquetas.Author %}<span><strong>Autor:</strong> {{ etiquetas.Author }}</span>{% endif %}
        
        {% if etiquetas.Family_Bloque %}<span><strong>Familia:</strong> {{ etiquetas.Family_Bloque }}</span>
        {% elif etiquetas['Library/Family'] %}<span><strong>Familia:</strong> {{ etiquetas['Library/Family'] }}</span>{% endif %}
        
        {% if etiquetas.Engineering %}<span><strong>Ingeniería:</strong> {{ etiquetas.Engineering }}</span>{% endif %}
        {% if etiquetas['Tested on System'] %}<span><strong>Probado en:</strong> {{ etiquetas['Tested on System'] }}</span>{% endif %}
    </div>

    {% if etiquetas.Restrictions and etiquetas.Restrictions != '--' %}
    <div style="margin-top:20px; padding:15px; background:#fff3cd; border-left:4px solid #ffc107; border-radius: 4px; color: #664d03;">
        <strong>⚠️ Restricciones:</strong> {{ etiquetas.Restrictions }}
    </div>
    {% endif %}
</div>

{% if etiquetas['Comment/Function'] %}
<div class="doc-section" id="descripcion">
    <h2 style="color: rgb(0, 52, 102); border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-top: 10px;">1. Descripción Funcional</h2>
    
    <div class="markdown-container">
        {{ etiquetas['Comment/Function'] | safe }}
    </div>
</div>
{% endif %}

{% if changelog %}
<div class="doc-section" id="changelog">
    <h2 style="color: rgb(0, 52, 102); border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-top: 10px;">2. Historial de Cambios</h2>
    <table class="scl-table">
        <thead>
            <tr>
            {% for cab in changelog.cabeceras %}
                <th>{{ cab }}</th>
            {% endfor %}
            </tr>
        </thead>
        <tbody>
        {% for fila in changelog.filas %}
            <tr>
                {% for col in fila %}
                <td style="color: #475569 !important; font-weight: normal !important;">{{ col }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{% if variables_agrupadas %}
<div class="doc-section" id="interfaz">
    <h2 style="color: rgb(0, 52, 102); border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-top: 10px;">3. Interfaz del Bloque</h2>
    
    {% for tipo_seccion, lista_vars in variables_agrupadas.items() %}
        
        {% set mostrar_columna_retain = tipo_seccion in ['Entradas', 'Salidas', 'Entrada/Salida', 'Estáticas'] %}

        <h3 style="color: #334155; margin-top: 25px; font-size: 1.1em; border-left: 4px solid rgb(0, 52, 102); padding-left: 10px;">{{ tipo_seccion }}</h3>
        <table class="scl-table">
            <thead>
                <tr>
                    <th>Parámetro</th>
                    <th>Tipo de Dato</th>
                    {% if mostrar_columna_retain %}
                    <th style="text-align: center; width: 80px;">Remanencia</th>
                    {% endif %}
                    <th>Descripción</th>
                </tr>
            </thead>
            <tbody>
            {% for var in lista_vars %}
                <tr>
                    <td style="font-family: monospace; font-weight: bold !important; color: #0f172a !important; width: 25%;">{{ var.nombre }}</td>
                    <td style="font-weight: normal !important; color: #475569 !important; width: 25%;"><span style="background-color: #e2e8f0; padding: 3px 8px; border-radius: 4px; font-family: monospace; font-size: 0.9em; color: #b91c1c !important; border: 1px solid #cbd5e1; font-weight: normal !important;">{{ var.tipo }}</span></td>
                    
                    {% if mostrar_columna_retain %}
                    <td style="text-align: center; color: #475569 !important; font-weight: normal !important; width: 80px;">
                        {% if var.is_retain %}
                            <span style="color: #16a34a !important; font-weight: bold !important;">✔️</span>
                        {% else %}
                            <span style="color: #94a3b8 !important;">-</span>
                        {% endif %}
                    </td>
                    {% endif %}

                    <td style="color: #475569 !important; font-weight: normal !important;">{{ var.descripcion }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endfor %}
</div>
{% endif %}

{% if dependencias %}
<div class="doc-section" id="dependencias">
    <h2 style="color: rgb(0, 52, 102); border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-top: 10px;">4. Dependencias Requeridas</h2>
    <ul style="margin-top: 15px; color: #334155; line-height: 1.8;">
        {% for dep in dependencias %}
            {% if dep.tipo == 'normal' %}
                <li><strong>{{ dep.clave }}:</strong> 
                    {% for elem in dep.elementos %}
                        {% if elem.url %}
                            <a href="{{ elem.url }}" style="color: #e74c3c; font-weight: bold; text-decoration: none;">{{ elem.nombre }}</a>
                        {% else %}
                            {{ elem.nombre }}
                        {% endif %}
                        {% if not loop.last %}, {% endif %}
                    {% endfor %}
                </li>
            {% endif %}
        {% endfor %}
    </ul>
</div>
{% endif %}

{% if contenido_original %}
<div class="doc-section" id="codigo_fuente">
    <h2 style="color: rgb(0, 52, 102); border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-top: 10px;">5. Código Fuente Completo</h2>
    <details style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 15px; margin-top: 20px;">
        <summary style="font-weight: bold; color: rgb(0, 52, 102); cursor: pointer; user-select: none; font-size: 1.05em;">
            Desplegar código SCL completo
        </summary>
        <pre style="background-color: #1e1e1e; color: #d4d4d4; padding: 20px; border-radius: 6px; overflow-x: auto; font-family: 'Consolas', monospace; font-size: 13px; line-height: 1.5; margin-top: 15px; border: 1px solid #333;"><code>{{ contenido_original | e }}</code></pre>
    </details>
</div>
{% endif %}
</file>

