from pathlib import Path
from domain.models import SiemensBlock

def generar_markdown_bloque(bloque: SiemensBlock, output_dir: Path) -> Path:
    md_lines = []
    
    # 1. Título con tu Badge Corporativo
    md_lines.extend([
        f"# <span class=\"scl-badge\">{bloque.block_type.value}</span> {bloque.name}",
        ""
    ])
    
    # 2. Caja de Metadatos (Estilo Dashboard de tu HTML original)
    md_lines.extend([
        '<div style="display: flex; flex-wrap: wrap; gap: 20px; color: #475569; font-size: 0.95em; margin-top: 25px; background: #f1f5f9; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">',
        f'  <span><strong>Versión:</strong> {bloque.version or "-"}</span>',
        f'  <span><strong>Autor:</strong> {bloque.author or "-"}</span>',
        f'  <span><strong>Familia:</strong> {bloque.family or "-"}</span>',
        f'  <span><strong>Hardware:</strong> {bloque.system_info.hardware or "-"}</span>',
        f'  <span><strong>Ingeniería:</strong> {bloque.system_info.engineering or "-"}</span>',
        '</div>',
        ''
    ])

    # 3. Descripción y Restricciones
    if bloque.description:
        md_lines.extend([
            "## Descripción Funcional",
            f"<div class=\"markdown-container\" markdown>",
            bloque.description,
            "</div>",
            ""
        ])

    if bloque.restrictions and bloque.restrictions.lower() != "ninguna.":
        md_lines.extend([
            "## Restricciones",
            f"<div style=\"border-left: 4px solid #e74c3c; padding: 10px; background: #fdf2f2;\"><strong>Aviso:</strong> {bloque.restrictions}</div>",
            ""
        ])

    # 4. Dependencias Cruzadas
    if bloque.dependencies:
        md_lines.extend(["## Dependencias Requeridas", ""])
        for dep in bloque.dependencies:
            elements_clean = [e.strip().replace('`', '') for e in dep.elements.split(',')]
            links = []
            for e in elements_clean:
                if e == "-": continue
                # Enrutamiento basado en las carpetas que auto-genera MkDocs
                if e.startswith("FC") or e.startswith("FB"):
                    links.append(f"[{e}](../Bloques de codigo/{e}.md)")
                else:
                    links.append(f"[{e}](../Estructura de datos/{e}.md)")
            
            md_lines.append(f"* **{dep.type}:** {', '.join(links)}")
        md_lines.append("")

    # 5. Interfaz de Variables (Usando tu clase CSS scl-table)
    if bloque.sections:
        md_lines.append("## Interfaz de Variables")
        for nombre_seccion, variables in bloque.sections.items():
            if not variables: continue
            
            md_lines.extend([
                f"### {nombre_seccion}",
                "| Nombre | Tipo | Retain | Valor Defecto | Comentario |",
                "|---|---|:---:|---|---|",
            ])
            for var in variables:
                com = var.comment if var.comment else "-"
                ret = "✔️" if var.is_retain else "-"
                md_lines.append(f"| `{var.name}` | `{var.data_type}` | {ret} | `{var.default_value}` | {com} |")
            
            # Forzamos tu clase corporativa a la tabla generada por Markdown
            md_lines.extend([
                "{: .scl-table }",
                ""
            ])

    # 6. Historial de Cambios
    if bloque.changelog_md:
        md_lines.extend([
            "## Historial de Cambios",
            bloque.changelog_md,
            "{: .scl-table }",
            ""
        ])

    # 7. Código Fuente (Usando tu acordeón HTML original)
    if bloque.source_code:
        md_lines.extend([
            '<div class="scl-section nivel-1">',
            '  <details>',
            '    <summary>Desplegar Código SCL</summary>',
            '    <div class="section-body">',
            '      <pre class="scl-code"><code>'
        ])
        # Escapar < y > por seguridad en HTML
        codigo_seguro = bloque.source_code.replace("<", "&lt;").replace(">", "&gt;")
        md_lines.append(codigo_seguro)
        md_lines.extend([
            '      </code></pre>',
            '    </div>',
            '  </details>',
            '</div>'
        ])

    archivo_salida = output_dir / f"{bloque.name}.md"
    archivo_salida.write_text("\n".join(md_lines), encoding="utf-8")
    return archivo_salida
